# Public values (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chrome extension ID (chrome://extensions) — needed to hand the session to the extension.
NEXT_PUBLIC_EXTENSION_ID=
NEXT_PUBLIC_CONTACT_URL=
# Cloudflare Turnstile SITE key (public). The SECRET key goes in Supabase > Auth > Captcha, never here.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# SERVER ONLY — never prefix with NEXT_PUBLIC_, never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=
