NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only: used to mint a separate session for the Chrome extension.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Chrome extension ID (chrome://extensions) — needed to hand the session to the extension.
NEXT_PUBLIC_EXTENSION_ID=
NEXT_PUBLIC_CONTACT_URL=mailto:contact@example.com
